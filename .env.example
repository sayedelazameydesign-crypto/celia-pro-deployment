# celia.pro Environment Configuration
# Copy this file to .env and update values for your environment
# NEVER commit .env to Git — it contains real secrets

# ============= DATABASE =============
POSTGRES_USER=celia
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=celia_db
POSTGRES_PORT=5432

# ============= REDIS =============
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_PORT=6379

# ============= JWT AUTHENTICATION =============
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_KEY_USE_OPENSSL_RAND_HEX_32
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ============= CORS =============
# Comma-separated list of allowed origins
# Example: CORS_ORIGINS=https://celia.pro,https://app.celia.pro
CORS_ORIGINS=

# ============= APPLICATION =============
ENVIRONMENT=production
DEBUG=false

# ============= PORTS =============
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============= LLM PROVIDERS =============
# Users can provide their own keys via the UI
# These are fallback keys if you want to provide system-wide access
# Get free API keys from:
# - Gemini: https://aistudio.google.com/app/apikey
# - Groq: https://console.groq.com/keys (free tier - ultra fast!)
# - HuggingFace: https://huggingface.co/settings/tokens
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# ============= DEPLOYMENT =============
# For cloud deployment (Neon DB + free-tier hosting):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/celia_db?sslmode=require
# SECRET_KEY: generate with: openssl rand -hex 32
# CORS_ORIGINS: comma-separated list of frontend origins (e.g. https://app.vercel.app)
DATABASE_URL=
SECRET_KEY=
VITE_API_URL=

# ============= LOGGING & MONITORING =============
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============= SENTRY ERROR TRACKING (Optional) =============
# Get DSN from: https://sentry.io
# Leave empty to disable Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============= MONITORING STACK (Optional) =============
# Enable with: docker compose --profile monitoring up
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ============= PERFORMANCE =============
# Number of uvicorn workers (adjust based on CPU cores)
UVICORN_WORKERS=2
